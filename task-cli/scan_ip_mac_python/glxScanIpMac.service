[Unit]
Description=GLX IP Scanner Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/path/to/scan_ip_mac_python
ExecStart=/usr/bin/python3 /path/to/scan_ip_mac_python/service.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
